{
  "name": "fabrica17-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite dev",
    "tokens:sync": "bun factory/scripts/sync-tokens.ts",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bun factory/scripts/architecture-check.ts && bun factory/scripts/verify-tokens.ts",
    "check:architecture": "bun factory/scripts/architecture-check.ts",
    "tokens:verify": "bun factory/scripts/verify-tokens.ts",
    "clean:template": "bun run factory/scripts/clean-template.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.104",
    "@iconify-json/mynaui": "^1.2.17",
    "@iconify-json/material-symbols": "^1.2.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.9.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.7"
  },
  "description": "Template base premium para proyectos de la agencia. Incluye sistema de diseño, utilidades globales, componentes interactivos y governance."
}
